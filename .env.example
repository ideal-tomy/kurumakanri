# Supabase (本番はクライアントが用意した値で上書き)
#
# NEXT_PUBLIC_SUPABASE_URL（クラウド）
#   誤り例: NEXT_PUBLIC_SUPABASE_URL=NEXT_PUBLIC_SUPABASE_URL=https://...（値に変数名を二度書かない）
#   完全な URL: https://（project-ref）.supabase.co
#   または project-ref だけ（例: ygpqzgagtevqeuhsvoua）でもアプリ側で https://...supabase.co に補正されます。
#   ローカル CLI: http://127.0.0.1:54321
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY
#   「API Keys」→ 公開可能なキー（sb_publishable_...）または従来の anon（eyJ... の長い JWT）をコピー
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# サイトの公開URL（メール内リンクの組み立てに使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 障害時の連絡先表示（管理画面ヘルプ用）
NEXT_PUBLIC_OPS_MANAGER_CONTACT=管理者

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Mail (Resend)
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=no-reply@shaken.example.jp

# 配信停止リンク用署名トークン
OPT_OUT_SECRET=replace-with-strong-secret

# Webhook 署名検証用
LINE_WEBHOOK_SECRET=
RESEND_WEBHOOK_SECRET=

# 自動送信機能（Edge Function daily-extract）
# 納品時は OFF。クライアントが運用に慣れた段階で true に切替。
AUTO_SEND_ENABLED=false
