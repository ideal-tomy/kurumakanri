# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LINE Messaging API
# https://developers.line.biz/console/ で取得
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token
LINE_CHANNEL_SECRET=your-channel-secret

# スタッフのLINE user_id（複数の場合カンマ区切り）
# Webhookで友だち追加した時のevent.source.userIdから取得
LINE_STAFF_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxx,Uyyyyyyyyyyyyyyyyyyyyyyyyy

# Cron認証用シークレット（任意の長い文字列）
CRON_SECRET=your-random-secret-string

# アプリのベースURL
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
